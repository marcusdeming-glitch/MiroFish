# ============================================================
#  MiroFish Configuration
#  Copy this file, rename it to:  .env
#  Then fill in your API keys below
# ============================================================

# ------ REQUIRED: Your AI (LLM) API Key ------
# Get a free key from: https://platform.openai.com/api-keys
# The Portfolio Analyzer only needs this one key to work.
LLM_API_KEY=paste-your-openai-api-key-here

# Which AI service to use (leave as-is for OpenAI)
LLM_BASE_URL=https://api.openai.com/v1

# Which AI model to use (gpt-4o-mini is cheap and works well)
LLM_MODEL_NAME=gpt-4o-mini


# ------ OPTIONAL: Zep Memory Key ------
# Only needed if you want to run full MiroFish simulations.
# NOT needed for the Portfolio Analyzer.
# Free key from: https://app.getzep.com
ZEP_API_KEY=paste-your-zep-key-here-or-leave-as-is
